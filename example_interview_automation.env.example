# ─── Required ────────────────────────────────────────────────────────────────

# Flask session signing key — use a long random string, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-random-secret-key-here

# Google Drive folder IDs
# Find these in the URL when you open a folder in Google Drive:
#   https://drive.google.com/drive/folders/<FOLDER_ID>
MAIN_FOLDER_ID=your-main-drive-folder-id
RECORDINGS_FOLDER_ID=your-recordings-folder-id

# YouTube channel ID (found in channel URL or via YouTube Studio)
YOUTUBE_CHANNEL_ID=your-youtube-channel-id

# ─── Optional ─────────────────────────────────────────────────────────────────

# Anthropic API key — can also be entered on the /batch page at runtime
# ANTHROPIC_API_KEY=sk-ant-...
